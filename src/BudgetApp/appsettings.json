{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=app.db;Cache=Shared"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gemini": {
    "Model": "gemini-3.8-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "TimeoutSeconds": 30
  },
  "Receipts": {
    "DailyLimitPerUser": 10,
    "DailyLimitTotal": 200,
    "MaxUploadBytes": 4000000,
    "MaxImageEdge": 2048
  }
}
