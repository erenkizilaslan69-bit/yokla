@page
@model LoginModel
@{
    ViewData["Title"] = "Giriş yap";
}

<div class="auth-wrap">
    <div class="card auth-card">
        <div class="text-center mb-4">
            <span class="brand-mark mb-3"><i class="bi bi-wallet2"></i></span>
            <h1>Tekrar hoş geldin</h1>
            <p class="text-muted mb-0">Hesabınla giriş yap.</p>
        </div>
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>
            <button id="login-submit" type="submit" class="btn btn-primary btn-lg w-100">Giriş yap</button>
        </form>
        <p class="text-center text-muted mt-4 mb-0">
            Hesabın yok mu? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold">Kayıt ol</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
