@model BudgetApp.Models.RecurringTransaction
@{
    ViewData["Title"] = "Tekrarlayan işlemi sil";
    var income = Model.Type == BudgetApp.Models.TransactionType.Income;
}

<div class="page-head"><h1>Tekrarlayan işlemi sil</h1></div>

<div class="card form-card p-3 p-md-4">
    <div class="alert alert-warning mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill alert-icon"></i>
        <div class="alert-body">
            Bu tanım silinince yeni işlem oluşmaz. Daha önce oluşan işlemler silinmez, normal işlem olarak kalır.
            Sadece bir süre ara vermek istiyorsan silmek yerine durdurabilirsin.
        </div>
    </div>
    <dl class="row mb-4">
        <dt class="col-sm-4">Ad</dt>
        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ItemName) ? Model.Category?.Name : Model.ItemName)</dd>
        <dt class="col-sm-4">Tür</dt>
        <dd class="col-sm-8">@(income ? "Gelir" : "Gider")</dd>
        <dt class="col-sm-4">Tutar</dt>
        <dd class="col-sm-8 fw-bold @(income ? "text-success" : "text-danger")">@Model.Amount.ToString("C2")</dd>
        <dt class="col-sm-4">Kategori</dt>
        <dd class="col-sm-8"><partial name="_CategoryBadge" model="Model.Category?.Name" /></dd>
        <dt class="col-sm-4">Gün</dt>
        <dd class="col-sm-8">Her ayın @Model.DayOfMonth. günü</dd>
    </dl>
    <form asp-action="Delete" method="post" class="d-flex gap-2">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i>Sil</button>
        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
    </form>
</div>
