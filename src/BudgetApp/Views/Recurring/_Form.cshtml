@model BudgetApp.Models.RecurringFormViewModel
@{
    var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
}

<div class="card form-card p-3 p-md-4">
    <form asp-action="@ViewContext.RouteData.Values["action"]" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" class="form-select" id="typeSelect">
                <option value="Expense">Gider</option>
                <option value="Income">Gelir</option>
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="Amount" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">₺</span>
                <input asp-for="Amount" asp-format="{0:0.00}" type="text" inputmode="decimal" class="form-control" placeholder="0,00" />
            </div>
            <span asp-validation-for="Amount" class="text-danger small"></span>
            <div class="form-text">Tutar her ay değişiyorsa tahmini tutarı yaz; oluşan işlemi sonradan düzeltebilirsin.</div>
        </div>
        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select" id="categorySelect">
                <option value="0">Seçin…</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DayOfMonth" class="form-label"></label>
            <select asp-for="DayOfMonth" class="form-select">
                @for (var day = 1; day <= 31; day++)
                {
                    <option value="@day">@day</option>
                }
            </select>
            <span asp-validation-for="DayOfMonth" class="text-danger small"></span>
            <div class="form-text">29, 30 veya 31 seçersen, o günü olmayan aylarda ayın son günü kullanılır.</div>
        </div>
        <div class="mb-3">
            <label asp-for="ItemName" class="form-label"></label>
            <input asp-for="ItemName" class="form-control" placeholder="ör. Ev kirası, Netflix" />
            <span asp-validation-for="ItemName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Note" class="form-label"></label>
            <input asp-for="Note" class="form-control" />
            <span asp-validation-for="Note" class="text-danger small"></span>
        </div>
        <div class="row">
            <div class="col-sm-6 mb-3">
                <label asp-for="StartDate" class="form-label"></label>
                @if (Model.IsNew)
                {
                    <input asp-for="StartDate" type="date" min="@monthStart.ToString("yyyy-MM-dd")" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                    <div class="form-text">Bu tarihten önceki günler için işlem oluşmaz.</div>
                }
                else
                {
                    <input type="text" class="form-control" value="@Model.StartDate?.ToString("dd.MM.yyyy")" disabled />
                }
            </div>
            <div class="col-sm-6 mb-3">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger small"></span>
            </div>
        </div>
        @if (!Model.IsNew)
        {
            <p class="small text-muted">Değişiklikler yalnızca bundan sonra oluşacak işlemlere uygulanır; daha önce oluşan işlemler değişmez.</p>
        }
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </div>
    </form>
</div>

<partial name="_TypeCategoryScript" />
