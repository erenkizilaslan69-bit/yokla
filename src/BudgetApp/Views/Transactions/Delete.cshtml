@model BudgetApp.Models.Transaction
@{
    ViewData["Title"] = "İşlemi sil";
    var income = Model.Type == BudgetApp.Models.TransactionType.Income;
}

<div class="page-head"><h1>İşlemi sil</h1></div>

<div class="card form-card p-3 p-md-4">
    <div class="alert alert-warning mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill alert-icon"></i>
        <div class="alert-body">Bu işlemi silmek istediğine emin misin? Bu işlem geri alınamaz.</div>
    </div>
    @if (ViewBag.Recurring is BudgetApp.Models.RecurringTransaction definition)
    {
        var definitionName = string.IsNullOrWhiteSpace(definition.ItemName) ? definition.Category?.Name : definition.ItemName;
        <div class="alert alert-success mb-3" role="note">
            <i class="bi bi-arrow-repeat alert-icon"></i>
            <div class="alert-body">
                Bu işlem <a asp-controller="Recurring" asp-action="Edit" asp-route-id="@definition.Id" class="fw-semibold">@definitionName</a>
                tekrarlayan tanımından oluştu. Silersen bu ay yeniden oluşmaz, gelecek aylarda oluşmaya devam eder.
                Tamamen durdurmak için <a asp-controller="Recurring" asp-action="Index" class="fw-semibold">tanımı durdur</a>.
            </div>
        </div>
    }
    <dl class="row mb-4">
        <dt class="col-sm-4">Tür</dt>
        <dd class="col-sm-8">@(income ? "Gelir" : "Gider")</dd>
        <dt class="col-sm-4">Tutar</dt>
        <dd class="col-sm-8 fw-bold @(income ? "text-success" : "text-danger")">@Model.Amount.ToString("C2")</dd>
        <dt class="col-sm-4">Tarih</dt>
        <dd class="col-sm-8">@Model.Date.ToString("dd.MM.yyyy")</dd>
        <dt class="col-sm-4">Kategori</dt>
        <dd class="col-sm-8"><partial name="_CategoryBadge" model="Model.Category?.Name" /></dd>
        <dt class="col-sm-4">Ürün</dt>
        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ItemName) ? "—" : Model.ItemName)</dd>
    </dl>
    <form asp-action="Delete" method="post" class="d-flex gap-2">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i>Sil</button>
        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
    </form>
</div>
