@model BudgetApp.Models.Transaction
@{
    ViewData["Title"] = "İşlemi sil";
}

<h1>İşlemi sil</h1>
<p class="text-danger">Bu işlemi silmek istediğinize emin misiniz?</p>
<dl class="row">
    <dt class="col-sm-2">Tür</dt>
    <dd class="col-sm-10">@(Model.Type == BudgetApp.Models.TransactionType.Income ? "Gelir" : "Gider")</dd>
    <dt class="col-sm-2">Tutar</dt>
    <dd class="col-sm-10">@Model.Amount.ToString("C2")</dd>
    <dt class="col-sm-2">Tarih</dt>
    <dd class="col-sm-10">@Model.Date.ToString("dd.MM.yyyy")</dd>
    <dt class="col-sm-2">Kategori</dt>
    <dd class="col-sm-10">@Model.Category?.Name</dd>
    <dt class="col-sm-2">Ürün</dt>
    <dd class="col-sm-10">@Model.ItemName</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Sil</button>
    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
</form>
