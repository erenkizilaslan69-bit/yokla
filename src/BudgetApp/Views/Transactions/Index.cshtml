@using BudgetApp.Models
@model TransactionsIndexViewModel
@inject BudgetApp.Services.IReceiptService Receipts
@{
    ViewData["Title"] = "İşlemler";
    var totals = Model.Totals;
}

@foreach (var warning in Model.Warnings)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill alert-icon"></i>
        <div class="alert-body">@warning</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="page-head">
    <h1>İşlemler</h1>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Recurring" asp-action="Index" class="btn btn-outline-primary d-inline-flex align-items-center gap-1"><i class="bi bi-arrow-repeat"></i>Tekrarlayanlar</a>
        <a asp-action="ExportCsv" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
           class="btn btn-outline-primary d-inline-flex align-items-center gap-1" title="@Model.Picker.Title işlemlerini Excel için CSV olarak indir">
            <i class="bi bi-download"></i>CSV indir
        </a>
        @if (Receipts.IsEnabled)
        {
            <a asp-controller="Receipts" asp-action="Scan" class="btn btn-outline-primary d-none d-md-inline-flex align-items-center gap-1"><i class="bi bi-receipt"></i>Fiş tara</a>
        }
        <a asp-action="Create" class="btn btn-primary d-none d-md-inline-flex align-items-center gap-1"><i class="bi bi-plus-lg"></i>Yeni işlem</a>
    </div>
</div>

<partial name="_MonthPicker" model="Model.Picker" />

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        @await Html.PartialAsync("_StatCard", ("Gelir", totals.Income.ToString("C2"), "arrow-down-circle-fill", "income", (string?)null))
    </div>
    <div class="col-6 col-md-4">
        @await Html.PartialAsync("_StatCard", ("Gider", totals.Expense.ToString("C2"), "arrow-up-circle-fill", "expense", (string?)null))
    </div>
    <div class="col-6 col-md-4">
        @await Html.PartialAsync("_StatCard", ("Bakiye", totals.Balance.ToString("C2"), "coin", "balance", (string?)null))
    </div>
</div>

@if (Model.Transactions.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", ("inbox", "Bu ay için işlem yok", "Gelir veya giderini ekleyerek başla; uyarılar ve analiz sana göre şekillenir.", (string?)"Yeni işlem", (string?)"Transactions", (string?)"Create"))
}
else
{
    @* Phones: rows grouped by day *@
    <div class="card d-md-none">
        @{ ViewData["Actions"] = true; }
        <partial name="_TransactionList" model="Model.Transactions" view-data="ViewData" />
    </div>

    @* Tablets and desktops: a table *@
    <div class="card d-none d-md-block">
        <div class="table-responsive">
            <table class="table tx-table">
                <thead>
                    <tr><th class="ps-3">Tarih</th><th>Kategori</th><th>Ürün</th><th>Not</th><th class="text-end">Tutar</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var t in Model.Transactions)
                {
                    var income = t.Type == TransactionType.Income;
                    <tr>
                        <td class="ps-3 text-nowrap">@t.Date.ToString("dd.MM.yyyy")</td>
                        <td>
                            <partial name="_CategoryBadge" model="t.Category?.Name" />
                            <partial name="_RecurringMark" model="t" />
                        </td>
                        <td>@t.ItemName</td>
                        <td class="text-muted">@t.Note</td>
                        <td class="text-end amount @(income ? "income" : "expense")">@(income ? "+" : "−")@t.Amount.ToString("C2")</td>
                        <td class="text-end pe-3 text-nowrap">
                            <a asp-action="Edit" asp-route-id="@t.Id" class="icon-btn" aria-label="Düzenle" title="Düzenle"><i class="bi bi-pencil-square"></i></a>
                            <a asp-action="Delete" asp-route-id="@t.Id" class="icon-btn danger" aria-label="Sil" title="Sil"><i class="bi bi-trash3"></i></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

