@using BudgetApp.Models
@model TransactionsIndexViewModel
@{
    ViewData["Title"] = "İşlemler";
    var totals = Model.Totals;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">İşlemler</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni işlem</a>
</div>

<div class="d-flex justify-content-center align-items-center gap-3 mb-3">
    <a asp-action="Index" asp-route-year="@Model.Previous.Year" asp-route-month="@Model.Previous.Month"
       class="btn btn-outline-secondary" aria-label="Önceki ay">&laquo;</a>
    <strong class="text-capitalize fs-5">@Model.Title</strong>
    @if (Model.IsCurrentMonth)
    {
        <span class="btn btn-outline-secondary disabled" aria-disabled="true" aria-label="Sonraki ay">&raquo;</span>
    }
    else
    {
        <a asp-action="Index" asp-route-year="@Model.Next.Year" asp-route-month="@Model.Next.Month"
           class="btn btn-outline-secondary" aria-label="Sonraki ay">&raquo;</a>
        <a asp-action="Index" class="btn btn-link">Bu ay</a>
    }
</div>

<div class="row mb-3 text-center">
    <div class="col-md-4"><div class="card card-body"><small class="text-muted">Gelir</small><strong class="text-success">@totals.Income.ToString("C2")</strong></div></div>
    <div class="col-md-4"><div class="card card-body"><small class="text-muted">Gider</small><strong class="text-danger">@totals.Expense.ToString("C2")</strong></div></div>
    <div class="col-md-4"><div class="card card-body"><small class="text-muted">Bakiye</small><strong>@totals.Balance.ToString("C2")</strong></div></div>
</div>

@if (Model.Transactions.Count == 0)
{
    <p class="text-muted">Bu ay için işlem yok.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Tarih</th><th>Kategori</th><th>Ürün</th><th>Not</th><th class="text-end">Tutar</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var t in Model.Transactions)
        {
            var income = t.Type == TransactionType.Income;
            <tr>
                <td>@t.Date.ToString("dd.MM.yyyy")</td>
                <td>@t.Category?.Name</td>
                <td>@t.ItemName</td>
                <td>@t.Note</td>
                <td class="text-end @(income ? "text-success" : "text-danger")">@(income ? "+" : "−")@t.Amount.ToString("C2")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
