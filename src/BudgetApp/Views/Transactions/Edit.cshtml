@model BudgetApp.Models.TransactionFormViewModel
@{
    ViewData["Title"] = "İşlemi düzenle";
}

<div class="page-head"><h1>İşlemi düzenle</h1></div>
<partial name="_Form" model="Model" />

@* Deleting lives here, not as a small icon on every row: the row itself opens this page. *@
<div class="form-card mt-3">
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash3 me-1"></i>İşlemi sil</a>
</div>
