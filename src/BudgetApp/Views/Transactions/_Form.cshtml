@model BudgetApp.Models.TransactionFormViewModel

<div class="card form-card p-3 p-md-4">
    <form asp-action="@ViewContext.RouteData.Values["action"]" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" class="form-select" id="typeSelect">
                <option value="Expense">Gider</option>
                <option value="Income">Gelir</option>
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="Amount" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">₺</span>
                <input asp-for="Amount" type="text" inputmode="decimal" class="form-control" placeholder="0,00" />
            </div>
            <span asp-validation-for="Amount" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
            <span asp-validation-for="Date" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select" id="categorySelect">
                <option value="0">Seçin…</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ItemName" class="form-label"></label>
            <input asp-for="ItemName" class="form-control" placeholder="ör. Süt 1 L" />
            <span asp-validation-for="ItemName" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Note" class="form-label"></label>
            <input asp-for="Note" class="form-control" />
            <span asp-validation-for="Note" class="text-danger small"></span>
        </div>
        @if (Model.Id == 0)
        {
            @* Only when adding: the saved transaction becomes the first occurrence of a monthly definition. *@
            <div class="form-check form-switch mb-4">
                <input asp-for="RepeatMonthly" class="form-check-input" role="switch" />
                <label asp-for="RepeatMonthly" class="form-check-label"></label>
                <div class="form-text">Kira, burs, abonelik gibi kalemler için: her ay aynı gün otomatik eklenir. Sonradan "Tekrarlayanlar" sayfasından durdurabilirsin.</div>
            </div>
        }
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </div>
    </form>
</div>

<partial name="_TypeCategoryScript" />
