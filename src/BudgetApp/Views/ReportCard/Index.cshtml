@using System.Globalization
@using BudgetApp.Services
@model BudgetApp.Models.ReportCardViewModel
@{
    ViewData["Title"] = "Karne";
    var tr = CultureInfo.GetCultureInfo("tr-TR");
    var card = Model.Card;
    var monthTitle = Model.Month.ToString("MMMM yyyy", tr);

    // The colour family of a level: Pekiyi and İyi green, Orta and Geçer gold, Zayıf red.
    string Tone(string? level) => level is null ? "none" : GradeScale.Rank(level) switch { >= 3 => "good", 0 => "low", _ => "mid" };
}

<div class="page-head">
    <h1>Ay karnesi</h1>
    <span class="text-muted fw-semibold text-capitalize">@monthTitle</span>
</div>

@if (card.IsGraded)
{
    <div class="card report-card p-3 p-md-4 mb-4">
        <div class="report-summary">
            <span class="grade @Tone(card.Level) grade-xl num" aria-hidden="true">@card.Points</span>
            <div>
                <div class="report-label">Genel puan</div>
                <div class="report-points">@card.Level <span class="num">@card.Points/100</span></div>
                @if (card.Comparison is { } comparison)
                {
                    <p class="report-compare mb-0">
                        <i class="bi @(comparison.Change > 0 ? "bi-arrow-up-right-circle-fill trend up" : comparison.Change < 0 ? "bi-arrow-down-right-circle-fill trend down" : "bi-dash-circle-fill trend flat")"></i>
                        @comparison.Text
                    </p>
                }
                else
                {
                    <p class="report-compare mb-0 text-muted">Karşılaştıracak daha eski bir karne yok.</p>
                }
            </div>
        </div>

        <div class="table-responsive mt-3">
            <table class="table report-table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Ders</th>
                        <th scope="col">Değer</th>
                        <th scope="col" class="text-end">Puan</th>
                        <th scope="col" class="text-end">Seviye</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in card.Courses)
                    {
                        <tr>
                            <th scope="row">
                                @course.Name <span class="report-weight">%@course.Weight.ToString("0")</span>
                                <div class="report-desc">@(course.NotGradedReason ?? course.Description)</div>
                            </th>
                            <td class="num">@course.Value</td>
                            <td class="num text-end">@(course.Points?.ToString() ?? "—")</td>
                            <td class="text-end text-nowrap">
                                @if (course.Trend is { } trend)
                                {
                                    <i class="bi @(trend > 0 ? "bi-arrow-up trend up" : trend < 0 ? "bi-arrow-down trend down" : "bi-dash trend flat")"
                                       title="@(trend > 0 ? "Önceki karneye göre yükseldi" : trend < 0 ? "Önceki karneye göre düştü" : "Önceki karneyle aynı")"></i>
                                }
                                @await Html.PartialAsync("_GradeBadge", (course.Level, (string?)null))
                            </td>
                        </tr>
                        @if (course.Kind == CourseKind.Budgets)
                        {
                            @* every limited category is a course of its own *@
                            @foreach (var category in card.Categories)
                            {
                                <tr class="report-sub">
                                    <th scope="row">@category.Category</th>
                                    <td class="num">%@category.UsagePercent.ToString("0", tr)</td>
                                    <td class="num text-end">@category.Points</td>
                                    <td class="text-end">@await Html.PartialAsync("_GradeBadge", ((string?)category.Level, (string?)null))</td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
        <p class="report-desc mt-2 mb-0">
            Genel puan, derslerin yanındaki ağırlıklarla ortalamasıdır; puanlanmayan dersin ağırlığı diğerlerine dağıtılır.
            Kategorilerdeki değer, limitin yüzde kaçının kullanıldığıdır.
            Seviyeler: Pekiyi 85–100 · İyi 70–84 · Orta 55–69 · Geçer 45–54 · Zayıf 0–44.
        </p>
    </div>

    <div class="card p-3 p-md-4 mb-4">
        <h2 class="section-title">Puanı yükseltmek için</h2>
        @if (card.Suggestions.Count == 0)
        {
            <p class="mb-0"><i class="bi bi-stars text-success me-1"></i>Bu ay yapılacak bir şey kalmamış; aynen devam.</p>
        }
        else
        {
            <ul class="report-tips mb-0">
                @foreach (var suggestion in card.Suggestions)
                {
                    <li><i class="bi bi-lightbulb-fill"></i><span>@suggestion.Text</span></li>
                }
            </ul>
        }
    </div>

    <div class="card p-3 p-md-4 mb-4">
        <h2 class="section-title">Karneni paylaş</h2>
        <div class="report-share">
            <canvas id="report-canvas" class="report-canvas" role="img" aria-label="@monthTitle karnesinin paylaşılabilir görseli"></canvas>
            <div>
                <p class="mb-2">Hikâye boyutunda (1080 × 1920) bir görsel. İçinde yalnızca puanlar, seviyeler ve yüzdeler var; <strong>hiçbir tutar görünmez</strong>.</p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary" data-report-download><i class="bi bi-download me-1"></i>Görseli indir</button>
                    <button type="button" class="btn btn-outline-primary" data-report-share hidden><i class="bi bi-share-fill me-1"></i>Paylaş</button>
                </div>
            </div>
        </div>
    </div>

    @* Everything the picture is drawn from. On purpose there is no amount of money and no user name in here. *@
    <script type="application/json" id="report-data">@Json.Serialize(new
    {
        month = monthTitle,
        file = $"karne-{card.Year}-{card.Month:00}.png",
        level = card.Level,
        tone = Tone(card.Level),
        points = card.Points,
        comparison = card.Comparison?.Text,
        courses = card.Courses.Select(c => new { name = c.Name, value = c.Value, level = c.Level, tone = Tone(c.Level) }),
        categories = card.Categories.Select(c => new
        {
            name = c.Category, value = "%" + c.UsagePercent.ToString("0", tr), level = c.Level, tone = Tone(c.Level)
        })
    })</script>
}
else
{
    @await Html.PartialAsync("_EmptyState", ("mortarboard", "Bu ay not verilmedi", card.Reason ?? "", (string?)null, (string?)null, (string?)null))
}

@section Scripts {
    @if (card.IsGraded)
    {
        <script src="~/js/report-card-image.js" asp-append-version="true"></script>
    }
}

@if (Model.History.Count > 0)
{
    <h2 class="section-title mt-4">Karnelerim</h2>
    <div class="report-months">
        @foreach (var item in Model.History)
        {
            var active = item.Year == card.Year && item.Month == card.Month;
            <a asp-action="Index" asp-route-year="@item.Year" asp-route-month="@item.Month"
               class="report-month @(active ? "active" : "")" aria-current="@(active ? "page" : null)"
               title="@(item.Reason ?? $"{item.Points}/100")">
                <span class="text-capitalize">@(new DateTime(item.Year, item.Month, 1).ToString("MMMM yyyy", tr))</span>
                @await Html.PartialAsync("_GradeBadge", (item.Level, (string?)null))
            </a>
        }
    </div>
}
