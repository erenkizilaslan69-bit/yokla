@model List<BudgetApp.Services.GoalProgress>
@{
    ViewData["Title"] = "Hedefler";
}

<div class="page-head">
    <h1>Hedefler</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Yeni hedef</a>
</div>

@if (Model.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", ("bullseye", "Henüz hedef yok", "Almak istediğin bir şey için hedef koy; ay sonlarında artan paranı oraya aktarabilirsin.", (string?)"Hedef oluştur", (string?)"Goals", (string?)"Create"))
}
else
{
    <div class="d-grid gap-3">
        @foreach (var progress in Model)
        {
            <div class="card p-3 p-md-4">
                <partial name="_GoalBar" model="progress" />
                @if (!progress.Goal.IsCompleted)
                {
                    @await Html.PartialAsync("_AddMoney", (progress, "goals", false))
                }
            </div>
        }
    </div>
}
