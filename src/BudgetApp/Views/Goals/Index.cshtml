@model List<BudgetApp.Services.GoalProgress>
@{
    ViewData["Title"] = "Hedefler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Hedefler</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni hedef</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Henüz hedef yok.</p>
}
else
{
    @foreach (var progress in Model)
    {
        <div class="card mb-3">
            <div class="card-body">
                <partial name="_GoalBar" model="progress" />
                @if (progress.Goal.IsCompleted)
                {
                    <small class="text-success">Hedefe ulaşıldı 🎉</small>
                }
                else
                {
                    <small class="text-muted">Kalan: @progress.Missing.ToString("C2")</small>
                }
            </div>
        </div>
    }
}
