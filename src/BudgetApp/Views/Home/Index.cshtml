@using System.Globalization
@model BudgetApp.Models.HomeViewModel
@inject BudgetApp.Services.IReceiptService Receipts
@{
    ViewData["Title"] = "Ana sayfa";
    var authenticated = User.Identity?.IsAuthenticated == true;
    ViewData["HasFab"] = authenticated; // the "+" button only exists for signed-in users
    var userName = User.Identity?.Name?.Split('@')[0];
    var monthTitle = DateTime.Today.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("tr-TR"));
}

@if (!authenticated)
{
    <div class="auth-wrap text-center">
        <div class="card auth-card">
            <div class="mb-3"><span class="brand-mark"><i class="bi bi-wallet2"></i></span></div>
            <h1>BudgetApp</h1>
            <p class="text-muted">Gelir ve giderlerini takip et, hedefine ne zaman ulaşacağını gör.</p>
            <ul class="list-unstyled text-start mx-auto mb-4" style="max-width: 18rem">
                <li class="mb-2"><i class="bi bi-lightning-charge-fill text-success me-2"></i>Harcamana anında uyarılar</li>
                <li class="mb-2"><i class="bi bi-pie-chart-fill text-success me-2"></i>Aylık analiz ve tavsiyeler</li>
                <li><i class="bi bi-bullseye text-success me-2"></i>Hedef barı ve ay sonu devri</li>
            </ul>
            <div class="d-grid gap-2">
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg">Giriş yap</a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary btn-lg">Kayıt ol</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="page-head">
        <h1>Merhaba, @userName</h1>
        <span class="text-muted fw-semibold text-capitalize">@monthTitle</span>
    </div>

    @if (Model.Allowance is { } dailyAllowance)
    {
        <partial name="_DailyAllowance" model="dailyAllowance" />
    }

    @if (Model.Pending is { } pending)
    {
        <div class="card carry-card p-3 p-md-4 mb-4">
            <div class="d-flex gap-3 align-items-start">
                <span class="carry-icon"><i class="bi bi-piggy-bank-fill"></i></span>
                <div class="flex-grow-1">
                    @if (pending.Remaining > 0 && Model.TransferAmount is { } amount && Model.ActiveGoal is { } goal)
                    {
                        <div class="fw-semibold text-capitalize mb-1">@Model.PendingMonthName devri</div>
                        @if (pending.AlreadyAdded > 0)
                        {
                            @* Part of the surplus was already put into goals by hand: only the rest is offered. *@
                            <p class="mb-1">
                                @Model.PendingMonthName ayında <span class="carry-amount">@pending.Remaining.ToString("N2") TL</span> artırdın;
                                @pending.AlreadyAdded.ToString("N2") TL'sini zaten hedefe eklemiştin.
                                Kalan <span class="carry-amount">@pending.Transferable.ToString("N2") TL</span>'yi aktaralım mı?
                            </p>
                        }
                        else
                        {
                            <p class="mb-1">
                                Geçen ay <span class="carry-amount">@pending.Remaining.ToString("C2")</span> artırdın.
                                <strong>@goal.Goal.Name</strong> hedefine aktaralım mı?
                            </p>
                        }
                        @if (amount < pending.Transferable)
                        {
                            <p class="small text-muted mb-2">Hedefe sadece @amount.ToString("C2") kaldığı için o kadarı aktarılır.</p>
                        }
                        <form asp-controller="MonthClose" asp-action="Close" method="post" class="d-flex flex-wrap gap-2 mt-2">
                            <input type="hidden" name="year" value="@pending.Year" />
                            <input type="hidden" name="month" value="@pending.Month" />
                            <button type="submit" name="transfer" value="true" class="btn btn-primary"><i class="bi bi-arrow-right-circle me-1"></i>Aktar</button>
                            <button type="submit" name="transfer" value="false" class="btn btn-outline-secondary">Şimdilik geçme</button>
                        </form>
                    }
                    else
                    {
                        <div class="fw-semibold text-capitalize mb-1">@Model.PendingMonthName özeti</div>
                        <p class="mb-2">
                            @if (pending.Remaining < 0)
                            {
                                <span>Geçen ay <span class="carry-amount text-danger">@((-pending.Remaining).ToString("C2"))</span> açık verdin.</span>
                            }
                            else if (pending.Remaining == 0)
                            {
                                <span>Geçen ayı başa baş kapattın.</span>
                            }
                            else if (pending.AlreadyAdded > 0)
                            {
                                <span>
                                    @Model.PendingMonthName ayında <span class="carry-amount">@pending.Remaining.ToString("N2") TL</span> artırdın;
                                    @pending.AlreadyAdded.ToString("N2") TL'sini zaten hedefe eklemiştin.
                                    @(pending.Transferable <= 0 ? "Aktarılacak tutar kalmadı." : "Aktarılacak aktif bir hedefin yok.")
                                </span>
                            }
                            else
                            {
                                <span>Geçen ay <span class="carry-amount">@pending.Remaining.ToString("C2")</span> artırdın. Aktarılacak aktif bir hedefin yok.</span>
                            }
                        </p>
                        <form asp-controller="MonthClose" asp-action="Close" method="post">
                            <input type="hidden" name="year" value="@pending.Year" />
                            <input type="hidden" name="month" value="@pending.Month" />
                            <input type="hidden" name="transfer" value="false" />
                            <button type="submit" class="btn btn-outline-primary">Tamam</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }

    @if (Model.Totals is { } totals)
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                @await Html.PartialAsync("_StatCard", ("Gelir", totals.Income.ToString("C2"), "arrow-down-circle-fill", "income", (string?)"Bu ay"))
            </div>
            <div class="col-6 col-md-4">
                @await Html.PartialAsync("_StatCard", ("Gider", totals.Expense.ToString("C2"), "arrow-up-circle-fill", "expense", (string?)"Bu ay"))
            </div>
            <div class="col-6 col-md-4">
                @if (Model.Projection is { } projection)
                {
                    var hasPending = projection.PendingIncome > 0 || projection.PendingExpenses > 0;
                    @await Html.PartialAsync("_StatCard", ("Tahmini kalan", projection.Projected.ToString("C2"), "graph-up-arrow", "balance", (string?)(hasPending ? "Ay sonunda · bekleyenler dahil" : "Ay sonunda")))
                }
                else
                {
                    @await Html.PartialAsync("_StatCard", ("Tahmini kalan", "—", "graph-up-arrow", "balance", (string?)"Bu ay henüz işlem yok"))
                }
            </div>
        </div>
    }

    @if (Model.ActiveGoal is { } active)
    {
        <partial name="_GoalHero" model="active" />
    }
    else if (Model.Celebration is { } reached)
    {
        <div class="card celebrate-card p-4 mb-4 text-center">
            <span class="celebrate-icon"><i class="bi bi-trophy-fill"></i></span>
            <h2 class="mb-1">Tebrikler, hedefine ulaştın!</h2>
            <p class="celebrate-goal mb-1">@reached.Name</p>
            <div class="celebrate-amount num">@reached.TargetAmount.ToString("C2")</div>
            <p class="text-muted mb-3">@reached.CompletedAt!.Value.ToString("dd.MM.yyyy") tarihinde tamamlandı.</p>
            <a asp-controller="Goals" asp-action="Create" class="btn btn-primary btn-lg"><i class="bi bi-plus-lg me-1"></i>Yeni hedef oluştur</a>
        </div>
    }
    else
    {
        <div class="mb-4">
            @await Html.PartialAsync("_EmptyState", ("bullseye", "Henüz bir hedefin yok", "Bir hedef koy; ay sonlarında artan paranı oraya aktaralım ve ne zaman ulaşacağını hesaplayalım.", (string?)"Hedef oluştur", (string?)"Goals", (string?)"Create"))
        </div>
    }

    @if (Model.Projection is not null || Model.GoalForecast is not null)
    {
        <div class="card p-3 mb-4">
            <div class="d-flex gap-3 align-items-start">
                <span class="stat-icon balance flex-shrink-0"><i class="bi bi-stars"></i></span>
                <div>
                    @if (Model.Projection is { } p)
                    {
                        <p class="mb-1">
                            @if (p.Projected >= 0)
                            {
                                <span>Bu tempoyla ay sonunda tahmini <strong>@p.Projected.ToString("C2")</strong> kalır.</span>
                            }
                            else
                            {
                                <span>Bu tempoyla ay sonunda tahmini <strong class="text-danger">@((-p.Projected).ToString("C2"))</strong> açık verirsin.</span>
                            }
                        </p>
                        @if (p.PendingIncome > 0 || p.PendingExpenses > 0)
                        {
                            <p class="small text-muted mb-1">
                                Bu ay henüz gelmemiş tekrarlayan işlemler tahmine dahil:
                                @if (p.PendingIncome > 0)
                                {
                                    <span>@p.PendingIncome.ToString("C2") gelir</span>
                                }
                                @if (p.PendingIncome > 0 && p.PendingExpenses > 0)
                                {
                                    <span>ve</span>
                                }
                                @if (p.PendingExpenses > 0)
                                {
                                    <span>@p.PendingExpenses.ToString("C2") gider</span>
                                }.
                            </p>
                        }
                    }
                    @if (Model.GoalForecast is { } gf)
                    {
                        <p class="mb-0">
                            @if (gf.Status == BudgetApp.Services.GoalForecastStatus.Reachable)
                            {
                                <span>Bu tempoyla @gf.Goal.Name hedefine <strong>@gf.ReachDate!.Value.ToString("MMMM yyyy")</strong> civarında ulaşırsın.</span>
                            }
                            else
                            {
                                <span>Bu tempoyla hedefe ulaşmak için harcamaları azaltman gerek.</span>
                            }
                        </p>
                    }
                </div>
            </div>
        </div>
    }

    @if (Model.Upcoming.Count > 0)
    {
        <div class="card mb-4">
            <div class="d-flex justify-content-between align-items-center px-3 pt-3 pb-2">
                <h2 class="section-title mb-0"><i class="bi bi-arrow-repeat text-success me-1"></i>Bu ay bekleyenler</h2>
                <a asp-controller="Recurring" asp-action="Index" class="small fw-semibold">Yönet <i class="bi bi-arrow-right"></i></a>
            </div>
            @foreach (var upcoming in Model.Upcoming)
            {
                var definition = upcoming.Definition;
                var isIncome = definition.Type == BudgetApp.Models.TransactionType.Income;
                <div class="tx-card">
                    <partial name="_CategoryIcon" model="definition.Category?.Name" />
                    <div class="tx-main">
                        <div class="tx-title">@(string.IsNullOrWhiteSpace(definition.ItemName) ? definition.Category?.Name : definition.ItemName)</div>
                        <div class="tx-sub">@definition.Category?.Name &middot; @upcoming.DueDate.ToString("dd.MM.yyyy")</div>
                    </div>
                    <div class="tx-side">
                        <div class="amount @(isIncome ? "income" : "expense")">@(isIncome ? "+" : "−")@definition.Amount.ToString("C2")</div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="card mb-4">
        <div class="d-flex justify-content-between align-items-center px-3 pt-3 pb-2">
            <h2 class="section-title mb-0">Son işlemler</h2>
            <a asp-controller="Transactions" asp-action="Index" class="small fw-semibold">Tümünü gör <i class="bi bi-arrow-right"></i></a>
        </div>
        @if (Model.Recent.Count == 0)
        {
            <div class="text-center text-muted px-3 pb-4 pt-2">
                <p class="mb-2">Henüz işlem yok.</p>
                <a asp-controller="Transactions" asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>İlk işlemini ekle</a>
            </div>
        }
        else
        {
            @foreach (var tx in Model.Recent)
            {
                <partial name="_TransactionCard" model="tx" />
            }
        }
    </div>

    @if (Receipts.IsEnabled)
    {
        <a asp-controller="Receipts" asp-action="Scan" class="fab fab-secondary d-md-none" aria-label="Fiş tara" title="Fiş tara"><i class="bi bi-camera-fill"></i></a>
    }
    <a asp-controller="Transactions" asp-action="Create" class="fab d-md-none" aria-label="Yeni işlem"><i class="bi bi-plus-lg"></i></a>
}
