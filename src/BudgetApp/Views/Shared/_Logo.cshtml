@model string
@* The Yokla wordmark: "Y", a gold coin in place of the "o", "kla". Model: "nav" (navbar) or "lg" (welcome, sign in, sign up).
   Always pass a model: without one the partial would receive the page's model. *@
<span class="logo@(Model == "lg" ? " logo-lg" : "")" role="img" aria-label="Yokla">Y<svg class="logo-coin" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><circle cx="20" cy="20" r="19" fill="#E0A526"/><circle cx="20" cy="20" r="13" fill="none" stroke="#8A5F0A" stroke-width="2.4" opacity=".5"/><path d="M12.5 13.5A10 10 0 0 1 20 10" fill="none" stroke="#FFF3C9" stroke-width="2.6" stroke-linecap="round"/></svg>kla</span>
