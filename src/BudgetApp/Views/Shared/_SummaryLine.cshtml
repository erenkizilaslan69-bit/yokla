@* A month's money in one quiet line instead of three boxes. Model: (label, the totals, show the balance). *@
@model (string Label, BudgetApp.Services.TransactionTotals Totals, bool ShowBalance)
@{
    var balance = Model.Totals.Balance;
}
<p class="summary-line">
    <span class="summary-label text-capitalize">@Model.Label</span>
    <span>Gelir <span class="money income">@Model.Totals.Income.ToString("C2")</span></span>
    <span class="summary-sep" aria-hidden="true">·</span>
    <span>Gider <span class="money">@Model.Totals.Expense.ToString("C2")</span></span>
    @if (Model.ShowBalance)
    {
        <span class="summary-sep" aria-hidden="true">·</span>
        <span>Kalan <span class="money @(balance < 0 ? "negative" : "")">@(balance < 0 ? "−" : "")@Math.Abs(balance).ToString("C2")</span></span>
    }
</p>
