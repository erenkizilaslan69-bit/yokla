@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="text-danger">Hata</h1>
<h2 class="text-danger">İsteğin işlenirken bir sorun oluştu.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>İstek kimliği:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>Lütfen sayfayı yenilemeyi veya ana sayfaya dönmeyi dene. Sorun devam ederse yukarıdaki istek kimliğiyle birlikte bildir.</p>
<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana sayfaya dön</a>
