@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="auth-wrap text-center">
    <div class="card auth-card">
        <div class="mb-3"><span class="empty-icon" style="background: var(--expense-soft); color: var(--expense)"><i class="bi bi-exclamation-triangle-fill"></i></span></div>
        <h1>Bir sorun oluştu</h1>
        <p class="text-muted">İsteğin işlenirken beklenmedik bir hata oluştu. Sayfayı yenilemeyi veya ana sayfaya dönmeyi dene.</p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">İstek kimliği: <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">Ana sayfaya dön</a>
    </div>
</div>
