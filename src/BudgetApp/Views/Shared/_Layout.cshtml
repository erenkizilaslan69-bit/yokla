@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    string Active(string c, string? a = null) =>
        controller == c && (a is null || action == a) ? "active" : "";
    string Current(string c, string? a = null) =>
        controller == c && (a is null || action == a) ? "page" : "";

    // "Tekrarlayan işlemler" is reached from the transactions page, so it lights up the same menu item.
    var inTransactions = controller is "Transactions" or "Recurring";
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0B7A5C" />
    <title>@ViewData["Title"] · Yokla</title>
    <partial name="_ThemeInit" />
    <link rel="preload" href="~/fonts/inter/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/bricolage-grotesque/bricolage-grotesque-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@* Signed in on a phone: the bottom tab bar replaces the hamburger menu; the body keeps room for it. *@
<body class="@(signedIn ? "has-tabbar" : "")">
    <header>
        <nav class="navbar navbar-expand-md app-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-wallet2"></i></span>Yokla
                </a>
                @if (signedIn)
                {
                    <partial name="_AccountMenu" />
                }
                else
                {
                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                            aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç/kapat">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                }
                <div class="navbar-collapse collapse" id="mainNav">
                    @if (signedIn)
                    {
                        <ul class="navbar-nav me-auto gap-md-1 ms-md-3">
                            <li class="nav-item">
                                <a class="nav-link @Active("Home", "Index")" aria-current="@Current("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i>Ana sayfa</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(inTransactions ? "active" : "")" aria-current="@(inTransactions ? "page" : "")" asp-area="" asp-controller="Transactions" asp-action="Index"><i class="bi bi-arrow-left-right"></i>İşlemler</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Goals")" aria-current="@Current("Goals")" asp-area="" asp-controller="Goals" asp-action="Index"><i class="bi bi-bullseye"></i>Hedefler</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Analysis")" aria-current="@Current("Analysis")" asp-area="" asp-controller="Analysis" asp-action="Index"><i class="bi bi-pie-chart-fill"></i>Analiz</a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        @* Signed out: only the sign in / register links on the right. *@
                        <div class="me-auto"></div>
                    }
                    <partial name="_ThemeToggle" />
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container app-main">
        <partial name="_Flash" />
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <span>&copy; 2026 Yokla</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
        </div>
    </footer>

    @if (signedIn)
    {
        <partial name="_TabBar" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
