@* "Kaydet" tick box and the remove / undo buttons of one line on a confirmation screen (receipt, quick entry).
   Model: the tick box's field name, e.g. "Lines[2].Include", and whether it is ticked.
   Without JavaScript the tick box itself decides; with it (receipt-review.js), the buttons drive the box. *@
@model (string Name, bool Include)
@{
    var id = Model.Name.Replace('[', '_').Replace(']', '_').Replace('.', '_');
}

<div class="receipt-remove">
    <div class="form-check receipt-include">
        <input type="checkbox" name="@Model.Name" id="@id" value="true" class="form-check-input" data-include @(Model.Include ? "checked" : null) />
        <input type="hidden" name="@Model.Name" value="false" />
        <label class="form-check-label small" for="@id">Kaydet</label>
    </div>
    <button type="button" class="icon-btn danger" data-remove aria-label="Satırı çıkar" title="Satırı çıkar" hidden><i class="bi bi-x-lg"></i></button>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-restore hidden>Geri al</button>
</div>
