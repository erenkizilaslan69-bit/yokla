@* A small figure card. Model: (Label, Value, Icon, Kind, Sub). Kind: income | expense | balance. *@
@model (string Label, string Value, string Icon, string Kind, string? Sub)

<div class="card stat-card">
    <div class="stat-top">
        <span class="stat-icon @Model.Kind"><i class="bi bi-@Model.Icon"></i></span>@Model.Label
    </div>
    <div class="stat-value @(Model.Kind == "income" ? "text-success" : Model.Kind == "expense" ? "text-danger" : "")">@Model.Value</div>
    @if (!string.IsNullOrEmpty(Model.Sub))
    {
        <div class="stat-sub">@Model.Sub</div>
    }
</div>
