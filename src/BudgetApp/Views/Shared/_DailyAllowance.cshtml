@* The one bold element of the home page: what can be spent today. Model: the allowance and, when this month's pace
   would use the money up before the next income, the warning that says when. Three looks: is-ok, is-over (today's
   spending went above today's share), is-deficit (nothing is left until the next income). *@
@using BudgetApp.Services
@using BudgetApp.Models
@model (DailyAllowance Allowance, PaceWarning? Pace)
@{
    var a = Model.Allowance;
    var today = DateTime.Today;
    var css = a.Status switch
    {
        AllowanceStatus.Deficit => "is-deficit",
        AllowanceStatus.OverToday => "is-over",
        _ => "is-ok"
    };
    var label = a.Status switch
    {
        AllowanceStatus.Deficit => a.Shortfall > 0 ? "Sonraki gelire kadar açığın" : "Sonraki gelire kadar paran kalmadı",
        AllowanceStatus.OverToday => "Bugünkü hakkını aştın",
        _ => "Bugün harcayabileceğin"
    };
    var amount = a.Status switch
    {
        AllowanceStatus.Deficit => a.Shortfall,
        AllowanceStatus.OverToday => -a.RemainingToday,
        _ => a.RemainingToday
    };
    var until = a.HasRecurringIncome
        ? $"Sonraki gelir {a.NextIncomeName}, {(a.DaysLeft == 1 ? "yarın" : $"{a.DaysLeft} gün sonra")}"
        : a.DaysLeft == 1 ? "Ayın son günü" : $"Ay sonuna {a.DaysLeft} gün";
    // Share of today's allowance already spent, for the bar (only while within it and once something was spent).
    var used = a.DailyAmount > 0 ? (int)Math.Min(100m, Math.Floor(a.SpentToday / a.DailyAmount * 100m)) : 0;
}

<section class="allowance-hero @css" aria-labelledby="allowanceLabel">
    <h2 class="allowance-label" id="allowanceLabel">@label</h2>
    <div class="allowance-amount">@amount.ToString("C2")</div>

    @switch (a.Status)
    {
        case AllowanceStatus.Deficit:
            <p class="allowance-line">
                @if (a.Available > 0)
                {
                    <span>Bugün <span class="money">@a.SpentToday.ToString("C2")</span> harcadın; kullanılabilir <span class="money">@a.Available.ToString("C2")</span> bitti.</span>
                }
                Bugün cüzdanı mümkünse hiç açma; makarna günleri.
            </p>
            break;
        case AllowanceStatus.OverToday:
            <p class="allowance-line">
                Bugünkü hak <span class="money">@a.DailyAmount.ToString("C2")</span> · harcanan <span class="money">@a.SpentToday.ToString("C2")</span>.
                @if (a.TomorrowAmount is { } tomorrow)
                {
                    <span>Fark yarından düşer; yarınki hakkın <span class="money">@tomorrow.ToString("C2")</span>.</span>
                }
            </p>
            break;
        default:
            if (a.SpentToday > 0)
            {
                <p class="allowance-line">Bugünkü hak <span class="money">@a.DailyAmount.ToString("C2")</span> · harcanan <span class="money">@a.SpentToday.ToString("C2")</span></p>
                <div class="allowance-track" role="progressbar" aria-label="Bugünkü hakkın kullanılan kısmı"
                     aria-valuenow="@used" aria-valuemin="0" aria-valuemax="100">
                    <div class="allowance-fill" style="width: @(used)%"></div>
                </div>
            }
            break;
    }

    <p class="allowance-meta">
        @until
        @if (a.Status != AllowanceStatus.Deficit)
        {
            <span>· kullanılabilir <span class="money">@a.Available.ToString("C2")</span></span>
        }
        @if (a.UpcomingExpenses > 0)
        {
            <span>· <span class="money">@a.UpcomingExpenses.ToString("C2")</span> tekrarlayan gidere ayrıldı</span>
        }
    </p>

    @if (Model.Pace is { } pace && a.Status != AllowanceStatus.Deficit)
    {
        <p class="allowance-pace">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>
                Bu ay günde ortalama <span class="money">@pace.DailyPace.ToString("C2")</span> harcıyorsun, hakkın <span class="money">@pace.DailyAmount.ToString("C2")</span>.
                Bu tempoyla elindeki para @TurkishDates.OnDay(pace.RunsOutOn, today) biter.
            </span>
        </p>
    }

    @if (!a.HasRecurringIncome)
    {
        <p class="allowance-hint">
            Gelirini <a asp-controller="Recurring" asp-action="Create">tekrarlayan işlem</a> olarak eklersen daha doğru hesaplarım.
        </p>
    }
</section>
