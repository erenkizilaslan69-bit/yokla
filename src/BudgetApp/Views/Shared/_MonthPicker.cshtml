@model BudgetApp.Models.MonthPickerViewModel

<div class="month-picker">
    <a asp-controller="@Model.Controller" asp-action="Index" asp-route-year="@Model.Previous.Year" asp-route-month="@Model.Previous.Month"
       class="round-btn" aria-label="Önceki ay"><i class="bi bi-chevron-left"></i></a>
    <span class="month-title text-capitalize">@Model.Title</span>
    @if (Model.IsCurrentMonth)
    {
        <span class="round-btn disabled" aria-disabled="true" aria-label="Sonraki ay"><i class="bi bi-chevron-right"></i></span>
    }
    else
    {
        <a asp-controller="@Model.Controller" asp-action="Index" asp-route-year="@Model.Next.Year" asp-route-month="@Model.Next.Month"
           class="round-btn" aria-label="Sonraki ay"><i class="bi bi-chevron-right"></i></a>
        <a asp-controller="@Model.Controller" asp-action="Index" class="btn btn-sm btn-outline-secondary ms-1">Bu ay</a>
    }
</div>
