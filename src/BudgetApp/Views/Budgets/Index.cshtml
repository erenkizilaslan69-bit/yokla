@using System.Globalization
@model BudgetApp.Models.BudgetsIndexViewModel
@{
    ViewData["Title"] = "Kategori bütçeleri";
    var monthTitle = Model.Month.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("tr-TR"));
}

<div class="page-head">
    <div>
        <a asp-controller="Analysis" asp-action="Index" class="small fw-semibold"><i class="bi bi-arrow-left"></i> Analiz</a>
        <h1>Kategori bütçeleri</h1>
    </div>
    <span class="text-muted fw-semibold text-capitalize">@monthTitle</span>
</div>

<p class="text-muted">Bir gider kategorisine aylık limit koy. Harcaman limitin %80'ini geçince "yaklaşıyorsun", %100'ünü geçince "aştın" uyarısı alırsın; her uyarı ayda bir kez gösterilir.</p>

<div class="row g-4">
    <div class="col-lg-5 order-lg-2">
        <div class="card p-3 p-md-4">
            <h2 class="section-title">Limit koy veya değiştir</h2>
            <form asp-action="Save" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Form.CategoryId" class="form-label"></label>
                    <select asp-for="Form.CategoryId" asp-items="Model.Form.Categories" class="form-select">
                        <option value="0">Seçin…</option>
                    </select>
                    <span asp-validation-for="Form.CategoryId" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.MonthlyLimit" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">₺</span>
                        <input asp-for="Form.MonthlyLimit" asp-format="{0:0.00}" type="text" inputmode="decimal" class="form-control" placeholder="0,00" />
                    </div>
                    <span asp-validation-for="Form.MonthlyLimit" class="text-danger small"></span>
                    <div class="form-text">Kategoride zaten limit varsa yenisiyle değiştirilir.</div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
            </form>
        </div>
    </div>

    <div class="col-lg-7 order-lg-1">
        @if (Model.Items.Count == 0)
        {
            @await Html.PartialAsync("_EmptyState", ("piggy-bank", "Henüz bütçe yok", "Kafe, dışarıda yemek, eğlence gibi kontrolden çıkabilen kategorilere bir limit koy; sınıra yaklaşınca haber verelim.", (string?)null, (string?)null, (string?)null))
        }
        else
        {
            <div class="card">
                @foreach (var item in Model.Items)
                {
                    <div class="budget-item">
                        <div class="flex-grow-1">
                            <partial name="_BudgetBar" model="item" />
                        </div>
                        <div class="budget-actions">
                            <a asp-action="Index" asp-route-categoryId="@item.Budget.CategoryId" class="icon-btn" aria-label="Düzenle" title="Düzenle"><i class="bi bi-pencil-square"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Budget.Id" method="post"
                                  onsubmit="return confirm('Bu bütçe silinsin mi?');">
                                <button type="submit" class="icon-btn danger" aria-label="Sil" title="Sil"><i class="bi bi-trash3"></i></button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
