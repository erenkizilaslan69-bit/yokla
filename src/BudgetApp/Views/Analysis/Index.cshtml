@using BudgetApp.Models
@model BudgetApp.Models.AnalysisViewModel
@{
    ViewData["Title"] = "Analiz";
    var a = Model.Analysis;
    var maxItem = a.TopItems.Count > 0 ? a.TopItems.Max(i => i.Amount) : 1m;
}

<div class="page-head"><h1>Aylık analiz</h1></div>

<partial name="_MonthPicker" model="Model.Picker" />

<div class="card p-3 p-md-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="section-title mb-0">Kategori bütçeleri</h2>
        <a asp-controller="Budgets" asp-action="Index" class="small fw-semibold">Limitleri yönet <i class="bi bi-arrow-right"></i></a>
    </div>
    @if (Model.Budgets.Count == 0)
    {
        <p class="text-muted mb-0">Henüz limit koymadın. Kafe, dışarıda yemek gibi kategorilere aylık limit koyarsan burada ilerlemesini görür, sınıra yaklaşınca uyarı alırsın.</p>
    }
    else
    {
        <div class="d-grid gap-3">
            @foreach (var budget in Model.Budgets)
            {
                <partial name="_BudgetBar" model="budget" />
            }
        </div>
    }
</div>

@if (a.Categories.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", ("pie-chart-fill", "Bu ay için gider yok", "Giderlerini ekledikçe kategori dağılımını, en çok harcadığın ürünleri ve tavsiyeleri burada göreceksin.", (string?)"Yeni işlem", (string?)"Transactions", (string?)"Create"))
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <div class="card p-3 p-md-4 h-100">
                <h2 class="section-title">Kategoriye göre giderler</h2>
                <div class="chart-wrap mb-3">
                    <canvas id="categoryChart" aria-label="Kategoriye göre gider dağılımı" role="img"></canvas>
                </div>
                <ul class="legend-list">
                    @foreach (var c in a.Categories)
                    {
                        var style = CategoryStyle.For(c.Name);
                        <li>
                            <span class="dot" style="--cat: @style.Color"></span>
                            <span class="legend-name">@c.Name</span>
                            <span class="fw-semibold num">@c.Amount.ToString("C2")</span>
                            <span class="text-muted small num" style="min-width: 2.75rem; text-align: right">%@((int)Math.Round(c.Amount / a.TotalExpense * 100m, MidpointRounding.AwayFromZero))</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card p-3 p-md-4 h-100">
                <h2 class="section-title">En çok harcanan ürünler</h2>
                @if (a.TopItems.Count == 0)
                {
                    <p class="text-muted mb-0">Ürün adı girilmiş gider yok. İşlem eklerken ürün adını yazarsan burada görünür.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr class="text-muted small"><th>Ürün</th><th class="text-end">Adet</th><th style="width: 22%"></th><th class="text-end">Tutar</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var item in a.TopItems)
                            {
                                <tr>
                                    <td>@item.ItemName</td>
                                    <td class="text-end text-muted">@item.Count&times;</td>
                                    <td><div class="mini-bar"><span style="width: @((int)Math.Round(item.Amount / maxItem * 100m))%"></span></div></td>
                                    <td class="text-end fw-semibold num">@item.Amount.ToString("C2")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card p-3 p-md-4 mb-4">
        <h2 class="section-title">Geçen aya göre değişim</h2>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr class="text-muted small"><th>Kategori</th><th class="text-end">Geçen ay</th><th class="text-end">Bu ay</th><th class="text-end">Fark</th><th class="text-end">%</th></tr>
                </thead>
                <tbody>
                @foreach (var c in a.Changes)
                {
                    var cls = c.Delta > 0 ? "up" : c.Delta < 0 ? "down" : "flat";
                    var icon = c.Delta > 0 ? "arrow-up-right" : c.Delta < 0 ? "arrow-down-right" : "dash";
                    <tr>
                        <td><partial name="_CategoryBadge" model="c.Name" /></td>
                        <td class="text-end num">@c.Previous.ToString("C2")</td>
                        <td class="text-end num">@c.Current.ToString("C2")</td>
                        <td class="text-end"><span class="delta @cls num"><i class="bi bi-@icon"></i> @(c.Delta > 0 ? "+" : "")@c.Delta.ToString("C2")</span></td>
                        <td class="text-end"><span class="delta @cls num">@(c.Percent is { } p ? $"{(p > 0 ? "+" : "")}{p:N0}%" : "—")</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <h2 class="section-title">Tavsiyeler</h2>
    <div class="d-grid gap-2 mb-4">
        @foreach (var tip in a.Advice)
        {
            <div class="card tip-card">
                <span class="tip-icon"><i class="bi bi-lightbulb-fill"></i></span>
                <div>@tip</div>
            </div>
        }
    </div>
}

@section Scripts {
    @if (a.Categories.Count > 0)
    {
        <script src="~/lib/chartjs/chart.umd.js"></script>
        <script>
            const labels = @Json.Serialize(a.Categories.Select(c => c.Name));
            const values = @Json.Serialize(a.Categories.Select(c => c.Amount));
            // Same colours as the badges on every other page.
            const colors = @Json.Serialize(a.Categories.Select(c => CategoryStyle.For(c.Name).Color));
            // Numbers go to JavaScript as numbers and are formatted here; passing a pre-formatted string would be
            // HTML-encoded by Razor, and a canvas does not decode HTML (the lira sign would turn into an entity).
            const totalAmount = @Json.Serialize(a.TotalExpense);
            const money = new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' });
            const total = money.format(totalAmount);
            const fontFamily = '"Inter Variable", system-ui, sans-serif';
            const css = getComputedStyle(document.documentElement);

            // Writes the month's total in the hole of the doughnut.
            const centerText = {
                id: 'centerText',
                afterDraw(chart) {
                    const { ctx, chartArea: { left, right, top, bottom } } = chart;
                    const x = (left + right) / 2, y = (top + bottom) / 2;
                    ctx.save();
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillStyle = css.getPropertyValue('--muted').trim() || '#66756F';
                    ctx.font = '600 12px ' + fontFamily;
                    ctx.fillText('Toplam gider', x, y - 15);
                    ctx.fillStyle = css.getPropertyValue('--text').trim() || '#1B2B26';
                    ctx.font = '800 21px ' + fontFamily;
                    ctx.fillText(total, x, y + 9);
                    ctx.restore();
                }
            };

            // Wait for the web font so the canvas text uses Inter too.
            (document.fonts ? document.fonts.ready : Promise.resolve()).then(function () {
                new Chart(document.getElementById('categoryChart'), {
                    type: 'doughnut',
                    data: { labels, datasets: [{ data: values, backgroundColor: colors, borderColor: '#fff', borderWidth: 3, hoverOffset: 6 }] },
                    options: {
                        cutout: '68%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: ctx => ` ${ctx.label}: ${money.format(ctx.parsed)}`
                                }
                            }
                        }
                    },
                    plugins: [centerText]
                });
            });
        </script>
    }
}
